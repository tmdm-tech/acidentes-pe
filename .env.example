PORT=8000
ADMIN_ACCESS_KEY=troque_esta_chave
APP_TIMEZONE=America/Recife
# Conexao principal direta com PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
POSTGRES_TABLE=public.acidentes
POSTGRES_BOOTSTRAP_LOCAL=true

# Opcional: manter sincronizacao de arquivos em Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_SYNC_ENABLED=false
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PREFIX=observa-backup
SUPABASE_STORAGE_SYNC_INTERVAL_SECONDS=300
# URL para abrir a area visual das planilhas/tabelas no Supabase pelo botao admin do app.
# Recomendado: abra no navegador a tabela "acidentes" em Supabase > Table Editor
# e copie a URL completa da barra de enderecos.
# Exemplo real configurado para este projeto.
SUPABASE_SPREADSHEETS_URL=https://supabase.com/dashboard/project/izdubenyjyxhtooaaxzv/editor/17552?schema=public
